{
  "name": "backd-admin-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The backd admin interface: a client of the admin API, embedded in the binary and served at /_ui/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "backd-js": "file:../../clients/js",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
