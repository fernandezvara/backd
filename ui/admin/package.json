{
  "name": "backd-admin-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The backd admin interface: a client of the admin API, embedded in the binary and served at /_ui/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "backd-js": "file:../../clients/js",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "backd-js": "file:../../clients/js",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vue-i18n": "$vue-i18n"
  }
}
