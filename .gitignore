# Local planning material — never commit
/support_docs/

# Hugo build output
/docs/public/
/docs/resources/_gen/
/docs/.hugo_build.lock

# Local build output
/bin/

# Local CA and certificates for the example stack (scripts/local-certs.sh)
/docker/certs/

# GoReleaser output (make release-check)
/dist/
# `go build ./cmd/backd` output
/backd
/cmd/backd/backd

# `backd functions build` output for test fixtures (built fresh by each run)
/clients/js/test/integration/config/**/_functions/.build/
# same, for the local stack's functions-build service (docker-compose.yml)
/examples/config/**/_functions/.build/

# Private Claude Code instructions (imports ~/.claude/projects/backd.md)
/CLAUDE.local.md

# Admin UI build output: embedded by internal/adminui (npm run build in ui/admin)
/internal/adminui/dist/*
!/internal/adminui/dist/.gitkeep

# defineFunction's runtime stub and import map, written next to each functions project
/examples/config/**/_functions/.backd/
# the Shelf's stub is committed: its tests (deno test) import @backd/functions through it
!/examples/config/shelf/main/_functions/.backd/
/examples/config/**/_functions/.backd-importmap.json
/clients/js/test/integration/config/**/_functions/.backd/
/clients/js/test/integration/config/**/_functions/.backd-importmap.json
perf-results/
# The development stack's default config (make dev-build)
/config/

# What the local stacks' scripts seed: sign-in details of the example users
# (passwords, TOTP secrets, recovery codes), served by nginx at /local-seed/
/local-seed/

deploy/kubernetes/pipeline/values.yaml
deploy/terraform/digitalocean/plan.txt

# Terraform and Kubernetes: state, saved plans, variable files and credentials hold secrets.
# A saved plan contains the whole state. Only the *.example files are committed.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/tfplan
deploy/terraform/**/plan.*
**/*.tfvars
!**/*.tfvars.example
**/backend.hcl
**/kubeconfig
**/kubeconfig.*
**/*.kubeconfig
