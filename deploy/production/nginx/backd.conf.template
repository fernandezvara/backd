# The public edge in front of backd: TLS, rate limits, body size limit and
# client addresses. A template: the nginx image fills in ${SERVER_NAME},
# ${ADMIN_ALLOW_FROM} and ${NGINX_LOCAL_RESOLVERS} (the container's DNS
# servers) at startup.

# backd's address is looked up per request, so a restarted backd is found.
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

server_tokens off;

# Rate limits per client address ($binary_remote_addr: nginx sees clients
# directly; see the docs if a load balancer sits in front of nginx).
#   auth: sign-up and login, where abuse is cheap for the client and costly
#         for the server (argon2id hashing, account creation).
#   func: calling a function, a baseline in front of whatever the function
#         itself declares (concurrency limits, its own rate_limit) —
#         functions can be expensive, and a webhook's own invoke rule must
#         allow anonymous callers, so this is the only edge protection an
#         anonymous-reachable one gets besides its own rate_limit.
#   api:  everything else under /v1/.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=func:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=api:10m  rate=20r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn:10m;
limit_conn_status 429;

# The request id nginx forwards to backd (X-Request-ID) is logged here too,
# so an nginx line and a backd line can be matched.
log_format edge '$remote_addr [$time_iso8601] "$request" $status $body_bytes_sent '
                '$request_time rid=$request_id';

server {
    listen 80;
    server_name ${SERVER_NAME};
    access_log /dev/stdout edge;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    access_log /dev/stdout edge;

    # Replace with your certificate (for example from Let's Encrypt).
    ssl_certificate     /etc/nginx/tls/edge.crt;
    ssl_certificate_key /etc/nginx/tls/edge.key;
    # Mozilla "intermediate" profile.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Browsers only use HTTPS for this host for two years. Add
    # includeSubDomains only if every subdomain serves HTTPS.
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Same as backd's MAX_BODY_BYTES: larger bodies never reach backd.
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    limit_conn conn 20;

    error_page 413 = @payload_too_large;
    error_page 429 = @too_many_requests;
    error_page 502 503 504 = @unavailable;

    set $backd http://backd:8080;

    # Headers for backd. X-Forwarded-For is overwritten, never appended:
    # nginx is the edge, so anything a client sent in it is a lie.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;

    # Sign-up and login: the strict limit, then the general one.
    location ~ ^/v1/[^/]+/_auth/(signup|login)$ {
        limit_req zone=auth burst=5 nodelay;
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backd;
    }

    # Calling a function: a per-address baseline (see the func zone above),
    # on top of the general limit.
    location ~ ^/v1/[^/]+/[^/]+/_func(/|$) {
        limit_req zone=func burst=5 nodelay;
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backd;
    }

    # The admin API, reachable only from ADMIN_ALLOW_FROM (default: all).
    # A second layer on top of backd's own checks (it still needs an API
    # key): set it to your operators' network. Others get a 404, as if the
    # route didn't exist.
    location ~ ^/v1/[^/]+/_admin(/|$) {
        allow ${ADMIN_ALLOW_FROM};
        deny all;
        error_page 403 = @not_found;
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backd;
    }

    location /v1/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backd;
    }

    # /healthz and /readyz stay internal: probe backd directly.
    location / {
        default_type application/json;
        return 404 '{"error":{"code":"not_found","message":"resource not found","request_id":"$request_id"}}\n';
    }
    location @not_found {
        default_type application/json;
        add_header Strict-Transport-Security "max-age=63072000" always;
        return 404 '{"error":{"code":"not_found","message":"resource not found","request_id":"$request_id"}}\n';
    }

    # Errors nginx answers itself use backd's error envelope.
    location @too_many_requests {
        default_type application/json;
        add_header Retry-After 60 always;
        add_header Strict-Transport-Security "max-age=63072000" always;
        return 429 '{"error":{"code":"too_many_requests","message":"too many requests; retry later","request_id":"$request_id"}}\n';
    }
    location @payload_too_large {
        default_type application/json;
        add_header Strict-Transport-Security "max-age=63072000" always;
        return 413 '{"error":{"code":"payload_too_large","message":"request body exceeds 1048576 bytes","request_id":"$request_id"}}\n';
    }
    location @unavailable {
        default_type application/json;
        add_header Strict-Transport-Security "max-age=63072000" always;
        return 503 '{"error":{"code":"unavailable","message":"service unavailable; retry later","request_id":"$request_id"}}\n';
    }
}
