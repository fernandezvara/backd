# Values of the Traefik chart, rendered by addons.tf (design/kubernetes.md §5). Traefik is the
# ingress controller: it ends TLS (certificates from cert-manager), redirects HTTP to HTTPS, and
# applies the per-route limits the Helm chart of backd declares as Middlewares.
deployment:
  replicas: ${replicas}

podDisruptionBudget:
  enabled: true
  minAvailable: 1

topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: ScheduleAnyway
    labelSelector:
      matchLabels:
        app.kubernetes.io/name: traefik

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    memory: 384Mi

# The dashboard, on Traefik's internal entry point only: that port is not in the Service, so it is
# reached with `kubectl -n traefik port-forward deploy/traefik 9000:8080` (then /dashboard/) by
# whoever has access to the cluster, and never from the internet.
ingressRoute:
  dashboard:
    enabled: true
    entryPoints: ["traefik"]

ingressClass:
  enabled: true
  isDefaultClass: true

providers:
  kubernetesCRD:
    enabled: true
    # A route may only use Middlewares of its own namespace.
    allowCrossNamespace: false
  kubernetesIngress:
    enabled: true

ports:
  web:
    # Plain HTTP only redirects.
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
    # The client's address arrives as the connection's source (a network load balancer does not
    # proxy), so nothing is believed from a header.
    forwardedHeaders:
      trustedIPs: []
  websecure:
    # X-Forwarded-For is never believed from a client: Traefik sets it from the connection.
    forwardedHeaders:
      trustedIPs: []
    transport:
      respondingTimeouts:
        # Realtime streams are held open for as long as a session lasts, so there is no write
        # deadline; a request is read within ten minutes (uploads of large files).
        readTimeout: 600s
        writeTimeout: 0s
        idleTimeout: 180s

service:
  annotations:
    service.beta.kubernetes.io/do-loadbalancer-name: ${lb_name}
    service.beta.kubernetes.io/do-loadbalancer-size-slug: ${lb_size}
    service.beta.kubernetes.io/do-loadbalancer-algorithm: ${lb_algorithm}
    service.beta.kubernetes.io/do-loadbalancer-protocol: tcp
    # A network load balancer: it passes packets through unchanged, so the client's address
    # reaches the node (with externalTrafficPolicy: Local) and there is no PROXY protocol. Do not
    # add `do-loadbalancer-hostname` or the PROXY protocol: the first leaves only a hostname in
    # the Service status, so Cilium never programs the load balancer's address and every
    # connection times out; the second is not supported by this type.
    service.beta.kubernetes.io/do-loadbalancer-type: REGIONAL_NETWORK
  spec:
    # The client's address reaches Traefik, and only nodes with a Traefik pod pass the load
    # balancer's health check.
    externalTrafficPolicy: Local
