# One origin for the local stack (docker-compose.yml), on https://localhost:8443
# (http://localhost:8080 redirects there):
#   /healthz /readyz /v1/  → backd
#   /example/              → the JavaScript client's example apps
#   everything else        → the documentation site (Hugo, with live reload)
#
# A template: the nginx image fills in ${NGINX_LOCAL_RESOLVERS} (the
# container's DNS servers) at startup. Upstreams are variables, so their
# addresses are looked up per request and a restarted backd or docs
# container is found at its new address.
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Plain HTTP only redirects, as in production (deploy/production).
server {
    listen 80;
    server_name localhost;
    return 301 https://localhost:8443$request_uri;
}

server {
    # TLS with a certificate from the local CA (scripts/local-certs.sh).
    listen 443 ssl;
    http2 on;
    server_name localhost;
    ssl_certificate     /etc/nginx/certs/localhost.crt;
    ssl_certificate_key /etc/nginx/certs/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # No Strict-Transport-Security here: browsers would apply it to every
    # site on localhost, whatever the port.

    # Relative Location headers: nginx listens on 443 but is published on 8443.
    absolute_redirect off;

    # Slightly above backd's MAX_BODY_BYTES (1 MiB), so backd answers 413 itself.
    client_max_body_size 2m;

    set $backd http://backd:8080;
    set $docs  http://docs:1313;

    # backd's HTTP API.
    location = /healthz { proxy_pass $backd; include /etc/nginx/proxy.inc; }
    location = /readyz  { proxy_pass $backd; include /etc/nginx/proxy.inc; }
    location /v1/       { proxy_pass $backd; include /etc/nginx/proxy.inc; }

    # The example app and the client library it imports (@backd/client).
    location = /example { return 301 /example/; }
    location /example/client/ {
        alias /srv/client/;
        add_header Cache-Control "no-store";
    }
    location /example/ {
        alias /srv/example/;
        add_header Cache-Control "no-store";
    }

    # Hugo's live reload: a websocket.
    location /livereload {
        proxy_pass $docs;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Hugo accepts the websocket only if its Origin matches the Host.
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
    }

    # The documentation site: landing page at /, docs under /docs/.
    location / {
        proxy_pass $docs;
        proxy_set_header Host $host;
    }
}
