{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false, "description": "Show the banner" },
        "message": { "type": "string", "maxLength": 200, "default": "" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true, "description": "Members may export their assets" }
          }
        }
      }
    }
  }
}
